# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection (Required)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="guinea_land_hub"

# CORS (adjust for production)
CORS_ORIGINS="*"

# Emergent Object Storage - for file uploads (Required)
# Get from Emergent Platform Dashboard
EMERGENT_LLM_KEY=YOUR_EMERGENT_KEY

# Email Notifications via Resend (Required for emails)
# Sign up at https://resend.com
RESEND_API_KEY=YOUR_RESEND_API_KEY
SENDER_EMAIL=notifications@yourdomain.com

# Mapbox - for map features (Required)
# Get from https://mapbox.com Account > Tokens
MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN

# SMS Notifications via Twilio (Optional)
# Sign up at https://twilio.com
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Frontend URL (for QR codes, email links)
FRONTEND_URL=https://your-domain.com
